# ── Discord ───────────────────────────────────────────────
# Bot token: https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_BOT_TOKEN=
# Your test server's ID. `npm run commands:dev` registers commands there instantly.
TEST_SERVER_ID=

# ── Database ──────────────────────────────────────────────
# Local dev: the TCP URL printed by `npm run db:dev`.
# Docker: ignored, docker-compose builds it from the POSTGRES_* values below.
DATABASE_URL=postgres://postgres:postgres@localhost:51214/template1?sslmode=disable
# Local dev only: scratch database for `npm run db:migrate` (the `prisma dev` shadow server, DB port + 1).
SHADOW_DATABASE_URL=postgres://postgres:postgres@localhost:51215/template1?sslmode=disable

# Docker Postgres credentials. Use letters and digits only, the password ends up in a URL.
POSTGRES_USER=railcore
POSTGRES_PASSWORD=change-me
POSTGRES_DB=railcore

# ── Misc ──────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
