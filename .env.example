# ── Discord ───────────────────────────────────────────────
# Bot token: https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_BOT_TOKEN=
# Your test server's ID. `npm run commands:dev` registers commands there instantly.
TEST_SERVER_ID=

# ── Database ──────────────────────────────────────────────
# Local dev: the local Postgres that `npm run db:dev` starts (this exact URL).
# Docker: ignored, docker-compose builds it from the POSTGRES_* values below.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/railcore

# Docker Postgres credentials. Use letters and digits only, the password ends up in a URL.
POSTGRES_USER=railcore
POSTGRES_PASSWORD=change-me
POSTGRES_DB=railcore

# ── Game stats (/stats) ───────────────────────────────────
# Optional. Without both keys, /stats says it isn't set up.
# Roblox Open Cloud key of the group that owns the game, read-only data store access.
ROBLOX_API_KEY=
# Bloxlink server API key (blox.link → Dashboard → Developer), finds members' Roblox accounts.
BLOXLINK_API_KEY=

# ── Misc ──────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
