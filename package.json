{
  "name": "railcore",
  "version": "0.1.0",
  "description": "Discord bot for Falkenberg Railways",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/scripts/dev-db.ts start && prisma generate && tsx watch --env-file-if-exists=.env src/index.ts",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "prisma generate && tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "commands:dev": "tsx --env-file-if-exists=.env src/scripts/deploy-commands.ts --guild",
    "commands:prod": "tsx --env-file-if-exists=.env src/scripts/deploy-commands.ts --prod",
    "commands:global": "tsx --env-file-if-exists=.env src/scripts/deploy-commands.ts --global",
    "db:dev": "tsx src/scripts/dev-db.ts start",
    "db:stop": "tsx src/scripts/dev-db.ts stop",
    "db:migrate": "prisma generate && prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "discord.js": "^14.27.0",
    "pino": "^10.4.0",
    "prisma": "7.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true
  }
}
